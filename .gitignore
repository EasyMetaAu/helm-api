# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.svelte-kit/
*.tsbuildinfo

# Test / coverage
coverage/
test-results/
playwright-report/

# Runtime data & secrets
data/
*.sqlite
*.sqlite3
*.db
.env
.env.*
!.env.example

# Local tooling / agent scaffolding (not project files)
.claude/
.codex/

# OS / editor
.DS_Store
*.log

# ralph-dev temp orchestration state
.ralph-dev/

# e2e artifacts
apps/gateway/.e2e-data/
apps/gateway/test-results/
apps/gateway/playwright-report/

# Playwright MCP browser snapshots (generated debugging artifacts; may contain
# local OAuth account labels / connection state — never commit)
.playwright-mcp/

# local docker test data
docker-data/

# Per-machine Compose override (absolute host paths + local build metadata;
# auto-loaded by `docker compose` — must stay local, never committed)
docker-compose.override.yml

# i18n translator generated config (non-secret, runtime only)
apps/admin/tools/.translator.env

# CodeGraph local index (per-machine, rebuilt from source — never committed)
.codegraph/
