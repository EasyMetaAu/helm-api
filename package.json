{
  "name": "helm-api",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "pnpm --filter @helm/admin dev",
    "dev:admin": "pnpm --filter @helm/admin dev",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @helm/gateway test:e2e",
    "test:e2e:coverage": "bash scripts/e2e-coverage.sh",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "build": "pnpm -r build",
    "sync:catalog": "tsx scripts/sync-catalog.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@helm/shared": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "c8": "^11.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
