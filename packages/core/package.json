{
  "name": "@helm/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/catalog/generated','dist/catalog/generated',{recursive:true})\""
  },
  "dependencies": {
    "@helm/shared": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "socks": "^2.8.9",
    "sqlite-vec": "^0.1.9",
    "undici": "^8.3.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "wreq-js": "^2.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.6",
    "@types/better-sqlite3": "^7.6.13"
  }
}
