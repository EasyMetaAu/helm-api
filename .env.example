# Helm API — example environment. Copy to .env and fill real values.
# NEVER commit real secrets. Env vars take precedence over config/*.yaml.
# Docker Compose and `pnpm start` load this file. A raw `node dist/index.js`
# command still expects variables to be exported by the shell.

# —— Admin UI (HTTP Basic, docs/11) ——
# Leave the password empty to use the token-protected browser setup on first run.
HELM_ADMIN_USER=admin
HELM_ADMIN_PASSWORD=
# Credentials auto-enable Admin. Set false to force it off; true without complete
# credentials mounts the surface but rejects every request with 401.
# HELM_ADMIN_ENABLED=true
# Set only for an intentionally headless deployment that must never expose /setup.
# HELM_SETUP_DISABLED=1

# —— Upstream provider credentials (injected via env, never in the repo) ——
# Each maps to a providers.yaml entry's `api_key_env`. Every static key is
# optional on first run. DEEPSEEK_API_KEY backs the shipped direct DeepSeek
# aliases and the optional Layer-2 eval call; absent providers are skipped.
# OPENAI_API_KEY / GEMINI_API_KEY back the OFFICIAL image providers. The shipped
# gpt-image lane intentionally uses ZenMux only; gemini-image leads with Google
# and falls over to ZenMux. An exact official OpenAI image alias remains available.
# An unset optional key makes that provider unavailable; fallback skips it.
# To route premium/coding lanes through a ChatGPT/Codex subscription, connect it
# in the admin UI (Providers → Connect) — that needs HELM_OAUTH_ENC_KEY below, not
# an api key here.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
ZENMUX_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# —— Optional runtime overrides (env wins over config/*.yaml) ——
HELM_HOST=0.0.0.0
HELM_PORT=8080
# Linux bind-mount ownership. Use the output of `id -u` and `id -g` when they
# differ; scripts/quickstart.sh fills these automatically.
HELM_UID=1000
HELM_GID=1000
# Parsed today, but routes are still mounted at /. Keep this value at /.
HELM_BASE_PATH=/
# Mandatory invariant: false is rejected at startup.
HELM_REQUIRE_API_KEY=true
HELM_DATA_DIR=./data
HELM_KEYS_PERSIST_TO=./data/helm-keys.json
HELM_REQUEST_TIMEOUT_MS=60000
HELM_SSE_HEARTBEAT_MS=15000
HELM_RATE_LIMIT_ENABLED=false
# Opt into Agentic Signals ranked-lane feedback. Thresholds live in config/runtime.yaml.
HELM_SIGNAL_FEEDBACK_ENABLED=false

# Optional memory LLM path. The deterministic memory worker remains available when
# this is off. Per-task models inherit HELM_MEMORY_LLM_MODEL when unset.
HELM_MEMORY_LLM_ENABLED=false
# HELM_MEMORY_LLM_MODEL=economy
# HELM_MEMORY_LLM_OBSERVATION_MODEL=
# HELM_MEMORY_LLM_REFLECTION_MODEL=
# HELM_MEMORY_LLM_FACTS_MODEL=
# HELM_MEMORY_LLM_TIMEOUT_MS=30000
# HELM_MEMORY_LLM_TEMPERATURE=0
# HELM_MEMORY_LLM_OBSERVATION_MAX_TOKENS=800
# HELM_MEMORY_LLM_REFLECTION_MAX_TOKENS=1200
# HELM_MEMORY_LLM_FACTS_MAX_TOKENS=1000

# Background workers and bounded writes.
# HELM_SIGNALS_DISABLED=1
# HELM_SIGNALS_INTERVAL_MS=60000
# HELM_MEMORY_WORKER_DISABLED=1
# HELM_MEMORY_WORKER_INTERVAL_MS=60000
# HELM_MEMORY_WORKER_BATCH_SIZE=50
# HELM_MEMORY_WORKER_MAX_BATCHES_PER_DRAIN=10
# HELM_MEMORY_WORKER_MAX_DRAIN_MS=30000
# HELM_MEMORY_WORKER_COALESCE_MS=8000
# HELM_MEMORY_WORKER_CONCURRENCY=3
# HELM_CLEANUP_DISABLED=1
# HELM_ARCHIVE_DIR=./data/archive
# HELM_AUTH_CACHE_TTL_MS=30000
# HELM_WRITE_QUEUE_FLUSH_MS=200
# HELM_WRITE_QUEUE_MAX_DEPTH=5000
# HELM_MEMORY_INJECT_TOKEN_BUDGET=4000
# HELM_SHUTDOWN_DRAIN_MS=10000

# HTTP egress tuning for high-throughput self-hosting.
# HELM_UNDICI_KEEPALIVE_MS=30000
# HELM_UNDICI_KEEPALIVE_MAX_MS=60000
# HELM_UNDICI_CONNECTIONS=128

# Optional TLS/JA3 transport tuning for subscription OAuth providers using
# transport_profile: auto/tls_chrome.
# HELM_TLS_BROWSER_PROFILE=chrome_136
# HELM_TLS_OS_PROFILE=macos
# HELM_TLS_TRANSPORT_TIMEOUT_MS=60000

# —— Storage driver (DB abstraction layer) ——
# 'sqlite' (default, local file under HELM_DATA_DIR) or 'supabase' (hosted Postgres).
HELM_STORE_DRIVER=sqlite
# For driver=supabase: HELM_STORE_URL_ENV names the env var holding the Postgres
# DSN (a reference, not the DSN). The DSN itself lives in that named var, e.g.:
#   HELM_STORE_DRIVER=supabase
#   HELM_STORE_URL_ENV=HELM_STORE_URL
#   HELM_STORE_URL=postgresql://user:pass@host:5432/dbname

# —— OAuth subscription providers (issue #38) ——
# Required ONLY if you connect a ChatGPT/Codex, Claude Pro/Max, GitHub Copilot,
# or xAI/SuperGrok subscription (admin dashboard → Providers). Encrypts the
# stored (rotating) refresh tokens at rest with AES-256-GCM. 32 bytes, as base64
# OR 64 hex chars. The gateway refuses
# to start if a subscription provider is configured without it. Generate one:
#   openssl rand -base64 32
# HELM_OAUTH_ENC_KEY=

# Optional emergency compatibility override for the first-party Grok CLI
# protocol version sent to cli-chat-proxy.grok.com. Keep the checked-in default
# unless xAI raises the minimum and inference returns HTTP 426. Must be semver.
# After overriding, run a real account smoke; remove it after upgrading Helm.
# HELM_XAI_GROK_CLIENT_VERSION=0.2.101

# Optional emergency compatibility override for the Codex subscription /models
# and User-Agent client version. Must be x.y.z; keep the checked-in default unless
# the upstream raises its minimum, then remove after upgrading Helm.
# HELM_OPENAI_CODEX_CLIENT_VERSION=0.145.0

# Optional: Claude/Codex OAuth callback helper for local login flows.
# HELM_OAUTH_CALLBACK_HOST=127.0.0.1

# Optional Memory MCP server is enabled in config/memory.yaml:
#   mcp:
#     enabled: true
#     oauth:
#       enabled: false
# The OAuth shim needs HELM_OAUTH_ENC_KEY because it signs MCP access tokens from
# a key derived from the same at-rest secret.
