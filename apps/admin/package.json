{
  "name": "@helm/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SvelteKit + Tailwind admin UI. Built static (adapter-static SPA), served by Hono at /admin.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
